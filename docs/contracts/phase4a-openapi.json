      "DecisionOptionsProjection": {
        "additionalProperties": false,
        "description": "Every REAL fact and constant needed to construct a legal decision.\n\nNothing here is invented: the bps and capital bounds are the engine's own\nstrict types and constants (`StrictBps`, `RELATIONSHIP_INVESTMENT_CAP`,\n`DECREE_POLITICAL_CAPITAL_COST`, `CONSTITUTIONAL_AMENDMENT_DECREE_COST`),\nand the spending, bloc and constitutional-axis listings are read straight\nfrom state. This endpoint answers \"what exists to choose from\" -- it never\nscores a draft (`/preview` does that) and never decides legality on\nsubmission (`/resolve`'s own validators still do, authoritatively).",
        "properties": {
          "blocs": {
            "items": {
              "$ref": "#/components/schemas/BlocOption"
            },
            "title": "Blocs",
            "type": "array"
          },
          "chambers": {
            "items": {
              "type": "string"
            },
            "title": "Chambers",
            "type": "array"
          },
          "constitutional_axes": {
            "items": {
              "$ref": "#/components/schemas/ConstitutionalAxisOption"
            },
            "title": "Constitutional Axes",
            "type": "array"
          },
          "decree_amendment_capital_cost": {
            "title": "Decree Amendment Capital Cost",
            "type": "integer"
          },
          "decree_available": {
            "title": "Decree Available",
            "type": "boolean"
          },
          "decree_legislative_capital_cost": {
            "title": "Decree Legislative Capital Cost",
            "type": "integer"
          },
          "opening_capital": {
            "title": "Opening Capital",
            "type": "integer"
          },
          "relationship_investment_maximum": {
            "title": "Relationship Investment Maximum",
            "type": "integer"
          },
          "relationship_investment_minimum": {
            "title": "Relationship Investment Minimum",
            "type": "integer"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "spending_categories": {
            "items": {
              "$ref": "#/components/schemas/SpendingCategoryOption"
            },
            "title": "Spending Categories",
            "type": "array"
          },
          "tax_rate_bps_maximum": {
            "title": "Tax Rate Bps Maximum",
            "type": "integer"
          },
          "tax_rate_bps_minimum": {
            "title": "Tax Rate Bps Minimum",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "opening_capital",
          "tax_rate_bps_minimum",
          "tax_rate_bps_maximum",
          "spending_categories",
          "relationship_investment_minimum",
          "relationship_investment_maximum",
          "decree_available",
          "decree_legislative_capital_cost",
          "decree_amendment_capital_cost",
          "chambers",
          "blocs",
          "constitutional_axes"
