{
  "name": "mandate-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MANDATE political strategy game \u2014 frontend. Config-only scaffold as of Phase 0/1; no gameplay UI exists yet (see docs/roadmap.md, Phase 5).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api:schema": "cd ../backend && uv run python scripts/dump_openapi.py > ../docs/contracts/phase4a-openapi.json",
    "generate:api:types": "cd tools/openapi-gen && npx openapi-typescript ../../../docs/contracts/phase4a-openapi.json -o ../../src/api/schema.d.ts",
    "generate:api": "npm run generate:api:schema && npm run generate:api:types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
