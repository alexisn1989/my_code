# MANDATE backend configuration — copy to .env for local development.
# Not read yet by anything in Phase 0/1 (no server, no DB); documented here so
# the Phase 4 API/DB layer has a stable place to land its configuration.

# --- Application ---
MANDATE_ENV=development
MANDATE_LOG_LEVEL=info

# --- Database (Phase 4+) ---
# Matches the service defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://mandate:mandate@localhost:5432/mandate

# --- Ruleset ---
# Bumped by hand when simulation balance/content changes in a way that must not
# retroactively affect already-resolved turns loaded from older snapshots.
MANDATE_RULESET_VERSION=0.1.0
